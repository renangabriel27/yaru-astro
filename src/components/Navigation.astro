---
import { site } from '../config';
import { t } from '../lib/i18n';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import NavMenu from './NavMenu.astro';
---
<header id="gh-navigation" class="gh-navigation gh-outer">
    <div class="gh-navigation-inner gh-inner">

        <div class="gh-navigation-brand">
            <a class="gh-navigation-logo" href={url('/')}>
                <span class="gh-navigation-title">{site.title}</span>
            </a>
            <button class="gh-search gh-icon-button" type="button" aria-label={t('Search this site')} data-search-toggle={url('/#search')}><Icon name="search" /></button>
            <button class="gh-burger gh-icon-button" type="button" aria-label={t('Menu')}>
                <Icon name="burger" />
                <Icon name="close" />
            </button>
        </div>

        <nav class="gh-navigation-menu">
            <NavMenu items={site.navigation} />
        </nav>

        <div class="gh-navigation-actions">
            <button class="gh-search gh-icon-button" type="button" aria-label={t('Search this site')} data-search-toggle={url('/#search')}><Icon name="search" /></button>
        </div>

    </div>
</header>

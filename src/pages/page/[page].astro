---
import type { GetStaticPaths } from 'astro';
import Home from '../../components/Home.astro';
import Layout from '../../layouts/Layout.astro';
import { getPosts, paginate } from '../../lib/posts';

export const getStaticPaths = (async () => {
    const posts = await getPosts();
    return paginate(posts)
        .slice(1)
        .map((pagination) => ({ params: { page: String(pagination.page) }, props: { pagination } }));
}) satisfies GetStaticPaths;

const { pagination } = Astro.props;
---
<Layout template="home-template" page={pagination.page}>
    <Home pagination={pagination} />
</Layout>
